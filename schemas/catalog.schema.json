{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wok-and-talk/schemas/catalog.schema.json",
  "title": "Wok & Talk — Catalog",
  "description": "data/catalog.json: the hub's restaurant cards and the global badge list.",
  "type": "object",
  "required": ["schemaVersion", "restaurants", "badges"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "restaurants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "emoji", "difficulty", "colors", "name", "cuisine", "blurb"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Matches data/restaurants/<id>.json when playable." },
          "status": { "enum": ["playable", "coming_soon"] },
          "emoji": { "type": "string" },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
          "colors": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } },
          "name": { "$ref": "restaurant.schema.json#/$defs/Text" },
          "cuisine": { "$ref": "restaurant.schema.json#/$defs/Text" },
          "blurb": { "type": "string" }
        }
      }
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "emoji", "name", "hint", "condition"],
        "properties": {
          "id": { "type": "string" },
          "emoji": { "type": "string" },
          "name": { "$ref": "restaurant.schema.json#/$defs/Text" },
          "hint": { "type": "string" },
          "condition": {
            "oneOf": [
              { "type": "object", "required": ["type", "count"], "properties": { "type": { "const": "mealsCompleted" }, "count": { "type": "integer", "minimum": 1 } } },
              { "type": "object", "required": ["type", "count"], "properties": { "type": { "const": "restaurantsCompleted" }, "count": { "type": "integer", "minimum": 1 } } },
              { "type": "object", "required": ["type"], "properties": { "type": { "const": "perfectMeal" }, "restaurant": { "type": "string" } } },
              { "type": "object", "required": ["type", "group", "choice"], "properties": { "type": { "const": "orderedChoice" }, "group": { "type": "string" }, "choice": { "type": "string" } } }
            ]
          }
        }
      }
    }
  }
}
